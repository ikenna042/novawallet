{
  "ConnectionStrings": {
    "Ledger": ""
  },
  "Jwt": {
    "Issuer": "novawallet-ledger",
    "Audience": "novawallet-ledger",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SeedAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "Ledger": {
    "DailyTransferLimitKobo": 50000000,
    "MaxTransactionAmountKobo": 10000000000
  },
  "RateLimiting": {
    "Transfers": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "UseJson": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
