# Optional overrides for docker compose. Copy to .env (git-ignored) and edit.
# The defaults in docker-compose.yml are for local demos only.
POSTGRES_PASSWORD=change-me
# At least 32 bytes. In a real deployment this comes from a secret store (e.g. Azure Key Vault), not a file.
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-bytes
# First administrator (created on first start; changing these later does not alter an existing account)
ADMIN_EMAIL=admin@yourbank.example
ADMIN_PASSWORD=use-a-long-unique-passphrase-1
AUTH_RATE_LIMIT=10
API_PORT=8080
DB_PORT=5433
# ₦500,000 in kobo
DAILY_TRANSFER_LIMIT_KOBO=50000000
